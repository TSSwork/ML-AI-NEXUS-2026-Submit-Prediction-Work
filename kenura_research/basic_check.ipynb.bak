   "source": [
    "### 5-Fold Multivariate Polynomial Hyperplane Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 61,
   "id": "b7b839e9-2f76-49ad-aff3-8e7f46f5a724",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--> Training 5-Fold Multivariate Polynomial Hyperplane GLM...\n",
      "\n",
      "==================================================\n",
      "Polynomial Hyperplane OOF Log Loss: 0.35448  (Linear: 0.35261)\n",
      "Polynomial Hyperplane ROC-AUC:      0.67791  (Linear: 0.68529)\n",
      "==================================================\n"
     ]
    }
   ],
   "source": [
    "from sklearn.preprocessing import PolynomialFeatures\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.model_selection import GridSearchCV\n",
    "\n",
    "print(\"--> Training 5-Fold Multivariate Polynomial Hyperplane GLM...\")\n",
    "\n",
    "oof_poly = np.zeros(len(train_fe))\n",
    "test_preds_poly = np.zeros(len(test_fe))\n",
    "\n",
    "# Focus polynomial expansion on continuous clinical variables to find non-linear curves & interactions\n",
    "poly_cols = [\n",
    "    'age', 'creatinine_mg_dl', 'hemoglobin_g_dl', 'sodium_mmol_l',\n",
    "    'heart_rate_bpm', 'systolic_bp_mmhg', 'prior_admissions_12m', \n",
    "    'comorbidity_count', 'length_of_stay_days'\n",
    "]\n",
    "non_poly_cols = [c for c in X.columns if c not in poly_cols and not c.endswith('_isna')]\n",
    "\n",
    "# Build pipeline: Degree-2 expansion (linear terms + quadratic squares + cross-product hyperplanes)\n",
    "poly_transformer = Pipeline([\n",
    "    ('scaler', StandardScaler()),\n",
    "    ('poly', PolynomialFeatures(degree=2, include_bias=False))\n",
    "])\n",
    "\n",
    "preprocessor_poly = ColumnTransformer(\n",
    "    transformers=[\n",
    "        ('poly_terms', poly_transformer, poly_cols),\n",
    "        ('other_num', StandardScaler(), [c for c in non_poly_cols if c in nn_num_cols]),\n",
    "        ('cat', OneHotEncoder(handle_unknown='ignore', sparse_output=False), [c for c in non_poly_cols if c in nn_cat_cols])\n",
    "    ]\n",
    ")\n",
    "\n",
    "for fold, (trn_idx, val_idx) in enumerate(skf.split(X, y), 1):\n",
    "    X_tr_raw, y_tr = X.iloc[trn_idx], y[trn_idx]\n",
    "    X_va_raw, y_va = X.iloc[val_idx], y[val_idx]\n",
    "    \n",
    "    # Generate polynomial feature matrix\n",
    "    X_tr_poly = preprocessor_poly.fit_transform(X_tr_raw)\n",
    "    X_va_poly = preprocessor_poly.transform(X_va_raw)\n",
    "    X_te_poly = preprocessor_poly.transform(X_test)\n",
    "    \n",
    "    # Grid search across 6 orders of magnitude of regularization strength\n",
    "    param_grid = {'C': [0.001, 0.01, 0.05, 0.1, 0.5, 1.0]}\n",
    "    \n",
    "    base_lr = LogisticRegression(max_iter=1000, random_state=42)\n",
    "    grid = GridSearchCV(\n",
    "        estimator=base_lr,\n",
    "        param_grid=param_grid,\n",
    "        scoring='neg_log_loss',\n",
    "        cv=3,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "    grid.fit(X_tr_poly, y_tr)\n",
    "    \n",
    "    best_poly_model = grid.best_estimator_\n",
    "    \n",
    "    oof_poly[val_idx] = best_poly_model.predict_proba(X_va_poly)[:, 1]\n",
    "    test_preds_poly += best_poly_model.predict_proba(X_te_poly)[:, 1] / 5\n",
    "\n",
    "oof_poly = np.clip(oof_poly, 0.005, 0.995)\n",
    "test_preds_poly = np.clip(test_preds_poly, 0.005, 0.995)\n",
    "\n",
    "poly_loss = log_loss(y, oof_poly)\n",
    "poly_auc = roc_auc_score(y, oof_poly)\n",
    "\n",
    "print(\"\\n\" + \"=\"*50)\n",
    "print(f\"Polynomial Hyperplane OOF Log Loss: {poly_loss:.5f}  (Linear: 0.35261)\")\n",
    "print(f\"Polynomial Hyperplane ROC-AUC:      {poly_auc:.5f}  (Linear: 0.68529)\")\n",
    "print(\"=\"*50)"
   ]
  },
