  {
   "cell_type": "markdown",
   "id": "8120c83f-3178-479e-884c-d58d7596b9b3",
   "metadata": {},
   "source": [
    "### Feature Engineering Cell\n",
    "\n",
    "The Missingness Takeaways\n",
    "\n",
    "- sodium_mmol_l: Patients without sodium measured have a lower readmission rate (10.9% vs 12.7%, a −1.7% drop). In hospitals, simple/healthy patients often skip comprehensive electrolyte panels.\n",
    "- creatinine_mg_dl & heart_rate_bpm: Patients missing these have higher readmission rates (+1.4% and +1.1%)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "6c206b7f-255e-4eee-9ec3-6e93e99eed58",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Features created successfully!\n",
      "Train columns before: 25 -> after: 38\n"
     ]
    }
   ],
   "source": [
    "# -------------------------------------------------------------\n",
    "# STEP 2: Feature Engineering & Preprocessing\n",
    "# -------------------------------------------------------------\n",
    "MISSING_COLS = [\n",
    "    'creatinine_mg_dl', 'heart_rate_bpm', 'hemoglobin_g_dl',\n",
    "    'sodium_mmol_l', 'systolic_bp_mmhg', 'followup_days'\n",
    "]\n",
    "\n",
    "def build_features(train_df, test_df):\n",
    "    tr = train_df.copy()\n",
    "    te = test_df.copy()\n",
    "    \n",
    "    for df in [tr, te]:\n",
    "        # 1. Missingness flags & total missing count\n",
    "        for col in MISSING_COLS:\n",
    "            df[f'{col}_isna'] = df[col].isna().astype(int)\n",
    "        df['n_missing'] = df[[f'{c}_isna' for c in MISSING_COLS]].sum(axis=1)\n",
    "        \n",
    "        # 2. Key clinical interactions from our charts\n",
    "        # Chart finding: heart_failure (27.3%) & CKD (20.3%) are the two highest risks\n",
    "        df['severe_cardiorenal'] = (df['heart_failure'] == 1) & (df['chronic_kidney_disease'] == 1).astype(int)\n",
    "        \n",
    "        # Chart finding: prior_admissions is monotonic and steep\n",
    "        df['high_utilizer'] = (df['prior_admissions_12m'] >= 3).astype(int)\n",
    "        df['risk_load'] = df['prior_admissions_12m'] * 2 + df['comorbidity_count']\n",
    "        \n",
    "        # Chart finding: age right-shift interaction with comorbidities\n",
    "        df['age_x_comorbidity'] = df['age'] * (df['comorbidity_count'] + 1)\n",
    "        \n",
    "        # 3. High/low lab abnormality flags (where KDE tails diverge)\n",
    "        df['anemia_flag'] = (df['hemoglobin_g_dl'] < 11.5).astype(float)\n",
    "        df['elevated_creatinine'] = (df['creatinine_mg_dl'] > 1.3).astype(float)\n",
    "        \n",
    "    # 4. Impute continuous labs using train medians (avoids test-to-train leakage)\n",
    "    for col in MISSING_COLS:\n",
    "        med = tr[col].median()\n",
    "        tr[col] = tr[col].fillna(med)\n",
    "        te[col] = te[col].fillna(med)\n",
    "        \n",
    "    return tr, te\n",
    "\n",
    "train_fe, test_fe = build_features(train, test)\n",
    "\n",
    "print(f\"Features created successfully!\")\n",
    "print(f\"Train columns before: {train.shape[1]} -> after: {train_fe.shape[1]}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5cc1948f-fe60-4a22-b759-ca46529eadc3",
   "metadata": {},
   "source": [
    "### 5-Fold Cross-Validation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 45,
   "id": "968206a2-777b-458c-b12c-14a8802c75a2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--> Training 5-Fold LightGBM & Random Forest Blend...\n",
      "\n",
      "Optimal Ensemble Weights -> LGBM: 0.192 | RF: 0.000 | CatBoost: 0.808\n",
      "\n",
      "=============================================\n",
      "             VALIDATION RESULTS             \n",
      "=============================================\n",
      "OOF Log Loss:    0.35038  (Baseline Logistic: 0.35261)\n",
      "OOF Brier Score: 0.10267  (Baseline Logistic: 0.10318)\n",
      "OOF ROC-AUC:     0.69071  (Baseline Logistic: 0.68529)\n",
      "=============================================\n",
      "Saved to ../outputs/submission_04_catboost_lgbm_blend.csv\n",
      "LightGBM OOF Log Loss:      0.35262\n",
      "Random Forest OOF Log Loss: 0.35289\n",
      "CatBoost OOF Log Loss:      0.35038\n",
      "Optimized Blend OOF Log Loss: 0.35354\n"
     ]
    }
   ],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "from sklearn.model_selection import StratifiedKFold\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from catboost import CatBoostClassifier\n",
    "from sklearn.metrics import log_loss, brier_score_loss, roc_auc_score\n",
    "import lightgbm as lgb\n",
    "import os\n",
    "\n",
    "target = 'readmitted_30d'\n",
    "drop_cols = ['patient_id', target]\n",
    "\n",
    "X = train_fe.drop(columns=drop_cols)\n",
    "y = train_fe[target].values\n",
    "X_test = test_fe.drop(columns=['patient_id'])\n",
    "\n",
    "# Treat object columns as native LightGBM categories\n",
    "cat_features = X.select_dtypes(include=['object', 'category', 'string', 'str']).columns.tolist()\n",
    "for c in cat_features:\n",
    "    X[c] = X[c].astype('category')\n",
    "    X_test[c] = X_test[c].astype('category')\n",
    "\n",
    "fold_experiments = [3, 5, 10]\n",
    "kfold_results = {}\n",
    "\n",
    "lgb_params = {\n",
    "    'objective': 'binary',\n",
    "    'metric': 'binary_logloss',\n",
    "    'boosting_type': 'gbdt',\n",
    "    'learning_rate': 0.03,\n",
    "    'num_leaves': 16,\n",
    "    'max_depth': 4,\n",
    "    'min_child_samples': 35,\n",
    "    'feature_fraction': 0.80,\n",
    "    'subsample': 0.85,\n",
    "    'reg_alpha': 0.5,\n",
    "    'reg_lambda': 1.0,\n",
    "    'random_state': 42,\n",
    "    'verbose': -1,\n",
    "    'n_estimators': 500\n",
    "}\n",
    "\n",
    "skf = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "oof_lgb = np.zeros(len(train_fe))\n",
    "test_preds_lgb = np.zeros(len(test_fe))\n",
    "oof_rf = np.zeros(len(train_fe))\n",
    "test_preds_rf = np.zeros(len(test_fe))\n",
    "oof_cb = np.zeros(len(train_fe))\n",
    "test_preds_cb = np.zeros(len(test_fe))\n",
    "feature_importances = np.zeros(X.shape[1])\n",
    "\n",
    "print(\"--> Training 5-Fold LightGBM & Random Forest Blend...\")\n",
    "\n",
    "for fold, (trn_idx, val_idx) in enumerate(skf.split(X, y), 1):\n",
    "    X_tr, y_tr = X.iloc[trn_idx], y[trn_idx]\n",
    "    X_va, y_va = X.iloc[val_idx], y[val_idx]\n",
    "    \n",
    "    # 1. Base tree model\n",
    "    base_lgb = lgb.LGBMClassifier(**lgb_params)\n",
    "    base_lgb.fit(\n",
    "        X_tr, y_tr,\n",
    "        eval_X=X_va, eval_y=y_va,\n",
    "        callbacks=[lgb.early_stopping(stopping_rounds=30, verbose=False)]\n",
    "    )\n",
    "    feature_importances += base_lgb.feature_importances_ / 5\n",
    "    \n",
    "    # 1. Base LightGBM\n",
    "    oof_lgb[val_idx] = base_lgb.predict_proba(X_va)[:, 1]\n",
    "    test_preds_lgb += base_lgb.predict_proba(X_test)[:, 1] / 5\n",
    "    \n",
    "    # 2. Random Forest (handles non-linearities with smooth bagging probabilities)\n",
    "    # Using one-hot / numeric representations for RF\n",
    "    rf_model = RandomForestClassifier(\n",
    "        n_estimators=300,\n",
    "        max_depth=8,              # Controlled depth prevents extreme leaf probabilities\n",
    "        min_samples_leaf=20,      # Smooths probability estimates in leaves\n",
    "        max_features='sqrt',\n",
    "        random_state=42,\n",
    "        n_jobs=-1\n",
    "    )\n",
    "    # Drop categorical object columns or use frequency/one-hot for RF\n",
    "    X_tr_rf = X_tr.select_dtypes(exclude=['category', 'object'])\n",
    "    X_va_rf = X_va.select_dtypes(exclude=['category', 'object'])\n",
    "    X_te_rf = X_test.select_dtypes(exclude=['category', 'object'])\n",
    "    \n",
    "    rf_model.fit(X_tr_rf, y_tr)\n",
    "    oof_rf[val_idx] = rf_model.predict_proba(X_va_rf)[:, 1]\n",
    "    test_preds_rf += rf_model.predict_proba(X_te_rf)[:, 1] / 5\n",
    "\n",
    "    # 3. CatBoost (native categorical handling, symmetric trees)\n",
    "    cb_model = CatBoostClassifier(\n",
    "        iterations=400,\n",
    "        learning_rate=0.03,\n",
    "        depth=4,\n",
    "        loss_function='Logloss',\n",
    "        eval_metric='Logloss',\n",
    "        random_seed=42,\n",
    "        verbose=False\n",
    "    )\n",
    "    # Convert categories back to string/object for CatBoost's native pool\n",
    "    X_tr_cb = X_tr.copy()\n",
    "    X_va_cb = X_va.copy()\n",
    "    X_te_cb = X_test.copy()\n",
    "    for col in cat_features:\n",
    "        X_tr_cb[col] = X_tr_cb[col].astype(str)\n",
    "        X_va_cb[col] = X_va_cb[col].astype(str)\n",
    "        X_te_cb[col] = X_te_cb[col].astype(str)\n",
    "        \n",
    "    cb_model.fit(X_tr_cb, y_tr, cat_features=cat_features, eval_set=(X_va_cb, y_va), early_stopping_rounds=30)\n",
    "    oof_cb[val_idx] = cb_model.predict_proba(X_va_cb)[:, 1]\n",
    "    test_preds_cb += cb_model.predict_proba(X_te_cb)[:, 1] / 5\n",
    "\n",
    "# 4. Mathematically Optimal Blending via Scipy SLSQP\n",
    "from scipy.optimize import minimize\n",
    "\n",
    "def loss_func(weights):\n",
    "    w1, w2, w3 = weights\n",
    "    pred = w1 * oof_lgb + w2 * oof_rf + w3 * oof_cb\n",
    "    return log_loss(y, np.clip(pred, 0.005, 0.995))\n",
    "\n",
    "# Find weights that sum to 1.0 and minimize log loss\n",
    "res = minimize(loss_func, [0.33, 0.33, 0.34], bounds=[(0, 1), (0, 1), (0, 1)], constraints={'type': 'eq', 'fun': lambda w: sum(w) - 1.0})\n",
    "w1, w2, w3 = res.x\n",
    "print(f\"\\nOptimal Ensemble Weights -> LGBM: {w1:.3f} | RF: {w2:.3f} | CatBoost: {w3:.3f}\")\n",
    "\n",
    "oof_blend = w1 * oof_lgb + w2 * oof_rf + w3 * oof_cb\n",
    "test_preds_blend = w1 * test_preds_lgb + w2 * test_preds_rf + w3 * test_preds_cb\n",
    "\n",
    "# 3. 3-Way Ensemble Blend (50% LightGBM + 30% Random Forest + 20% Linear/Prior)\n",
    "oof_blend = 0.50 * oof_lgb + 0.30 * oof_rf + 0.20 * 0.125857\n",
    "test_preds_blend = 0.50 * test_preds_lgb + 0.30 * test_preds_rf + 0.20 * 0.125857\n",
    "\n",
    "# Apply the optimal weights (0.192 LGBM + 0.808 CatBoost)\n",
    "oof_final = w1 * oof_lgb + w2 * oof_rf + w3 * oof_cb\n",
    "test_final = w1 * test_preds_lgb + w2 * test_preds_rf + w3 * test_preds_cb\n",
    "\n",
    "oof_preds = np.clip(oof_final, 0.005, 0.995)\n",
    "test_preds = np.clip(test_final, 0.005, 0.995)\n",
    "\n",
    "# Calculate Validation Scores on the true optimal blend\n",
    "cv_logloss = log_loss(y, oof_preds)\n",
    "cv_brier = brier_score_loss(y, oof_preds)\n",
    "cv_auc = roc_auc_score(y, oof_preds)\n",
    "\n",
    "print(\"\\n\" + \"=\"*45)\n",
    "print(\"             VALIDATION RESULTS             \")\n",
    "print(\"=\"*45)\n",
    "print(f\"OOF Log Loss:    {cv_logloss:.5f}  (Baseline Logistic: 0.35261)\")\n",
    "print(f\"OOF Brier Score: {cv_brier:.5f}  (Baseline Logistic: 0.10318)\")\n",
    "print(f\"OOF ROC-AUC:     {cv_auc:.5f}  (Baseline Logistic: 0.68529)\")\n",
    "print(\"=\"*45)\n",
    "\n",
    "# Save Submission File\n",
    "os.makedirs('../outputs', exist_ok=True)\n",
    "sub = pd.DataFrame({\n",
    "    'patient_id': test_fe['patient_id'],\n",
    "    'readmitted_30d': test_preds\n",
    "})\n",
    "sub.to_csv('../outputs/submission_04_catboost_lgbm_blend.csv', index=False)\n",
    "print(\"Saved to ../outputs/submission_04_catboost_lgbm_blend.csv\")\n",
    "\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "\n",
    "print(f\"LightGBM OOF Log Loss:      {log_loss(y, np.clip(oof_lgb, 0.005, 0.995)):.5f}\")\n",
    "print(f\"Random Forest OOF Log Loss: {log_loss(y, np.clip(oof_rf, 0.005, 0.995)):.5f}\")\n",
    "print(f\"CatBoost OOF Log Loss:      {log_loss(y, np.clip(oof_cb, 0.005, 0.995)):.5f}\")\n",
    "print(f\"Optimized Blend OOF Log Loss: {log_loss(y, np.clip(oof_blend, 0.005, 0.995)):.5f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "259b6d82-9440-4ddd-b9c8-3c2013c8b4ee",
   "metadata": {},
   "source": [
    "### Explainable Boosting Machine"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 47,
   "id": "21256606-febd-43b3-83aa-59d4af08eb62",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--> Training 5-Fold Explainable Boosting Machine (EBM)...\n",
      "\n",
      "=============================================\n",
      "EBM OOF Log Loss:  0.35034  (CatBoost: 0.35038)\n",
      "EBM ROC-AUC:       0.69051   (CatBoost: 0.69071)\n",
      "=============================================\n"
     ]
    }
   ],
   "source": [
    "from interpret.glassbox import ExplainableBoostingClassifier\n",
    "\n",
    "print(\"--> Training 5-Fold Explainable Boosting Machine (EBM)...\")\n",
    "\n",
    "oof_ebm = np.zeros(len(train_fe))\n",
    "test_preds_ebm = np.zeros(len(test_fe))\n",
    "\n",
    "# EBM handles categorical and numerical columns natively\n",
    "ebm_cols = [c for c in X.columns if not c.endswith('_isna')]  # Drop raw flags to keep curves clean\n",
    "\n",
    "for fold, (trn_idx, val_idx) in enumerate(skf.split(X[ebm_cols], y), 1):\n",
    "    X_tr, y_tr = X[ebm_cols].iloc[trn_idx], y[trn_idx]\n",
    "    X_va, y_va = X[ebm_cols].iloc[val_idx], y[val_idx]\n",
    "    \n",
    "    ebm = ExplainableBoostingClassifier(\n",
    "        max_bins=128,\n",
    "        interactions=10,         # Learns top 10 two-way clinical interactions automatically\n",
    "        outer_bags=8,\n",
    "        inner_bags=0,\n",
    "        random_state=42\n",
    "    )\n",
    "    ebm.fit(X_tr, y_tr)\n",
    "    \n",
    "    oof_ebm[val_idx] = ebm.predict_proba(X_va)[:, 1]\n",
    "    test_preds_ebm += ebm.predict_proba(X_test[ebm_cols])[:, 1] / 5\n",
    "\n",
    "oof_ebm = np.clip(oof_ebm, 0.005, 0.995)\n",
    "test_preds_ebm = np.clip(test_preds_ebm, 0.005, 0.995)\n",
    "\n",
    "ebm_loss = log_loss(y, oof_ebm)\n",
    "ebm_auc = roc_auc_score(y, oof_ebm)\n",
    "\n",
    "print(\"\\n\" + \"=\"*45)\n",
    "print(f\"EBM OOF Log Loss:  {ebm_loss:.5f}  (CatBoost: 0.35038)\")\n",
    "print(f\"EBM ROC-AUC:       {ebm_auc:.5f}   (CatBoost: 0.69071)\")\n",
    "print(\"=\"*45)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "d42c99ce-8d80-4c02-b7b3-91911f1c1881",
   "metadata": {},
   "source": [
    "### Blend EBM + CatBoost"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 48,
   "id": "313fef75-1dca-4d03-9142-37d4f37768b6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "=============================================\n",
      "Grand Blend OOF Log Loss:  0.34955\n",
      "Grand Blend ROC-AUC:       0.69211\n",
      "=============================================\n",
      "Saved to ../outputs/submission_05_ebm_catboost_blend.csv\n"
     ]
    }
   ],
   "source": [
    "# -------------------------------------------------------------\n",
    "# Grand Ensemble: Glass-Box EBM (50%) + CatBoost (50%)\n",
    "# -------------------------------------------------------------\n",
    "oof_grand = 0.50 * oof_ebm + 0.50 * oof_cb\n",
    "test_grand = 0.50 * test_preds_ebm + 0.50 * test_preds_cb\n",
    "\n",
    "oof_grand = np.clip(oof_grand, 0.005, 0.995)\n",
    "test_grand = np.clip(test_grand, 0.005, 0.995)\n",
    "\n",
    "grand_loss = log_loss(y, oof_grand)\n",
    "grand_auc = roc_auc_score(y, oof_grand)\n",
    "\n",
    "print(\"=\"*45)\n",
    "print(f\"Grand Blend OOF Log Loss:  {grand_loss:.5f}\")\n",
    "print(f\"Grand Blend ROC-AUC:       {grand_auc:.5f}\")\n",
    "print(\"=\"*45)\n",
    "\n",
    "# Save Final Submission\n",
    "sub_final = pd.DataFrame({\n",
    "    'patient_id': test_fe['patient_id'],\n",
    "    'readmitted_30d': test_grand\n",
    "})\n",
    "sub_final.to_csv('../outputs/submission_05_ebm_catboost_blend.csv', index=False)\n",
    "print(\"Saved to ../outputs/submission_05_ebm_catboost_blend.csv\")"
   ]
  },
