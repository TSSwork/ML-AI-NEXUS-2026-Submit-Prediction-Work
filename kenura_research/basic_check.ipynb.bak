    "# Train one EBM on the full dataset to extract exact global explanations\n",
    "ebm_global = ExplainableBoostingClassifier(max_bins=128, interactions=10, random_state=42)\n",
    "ebm_global.fit(X[ebm_cols], y)\n",
    "\n",
    "ebm_global_perf = ebm_global.explain_global(name='EBM Global Explanation')\n",
    "\n",
    "# Plot top risk factors as a clean horizontal bar chart\n",
    "importances = ebm_global.term_importances()\n",
    "term_names = ebm_global.term_names_\n",
    "\n",
    "fi_ebm = pd.DataFrame({'Feature/Interaction': term_names, 'Importance': importances})\n",
    "fi_ebm = fi_ebm.sort_values('Importance', ascending=False).head(10)\n",
    "\n",
    "plt.figure(figsize=(10, 5))\n",
    "sns.barplot(data=fi_ebm, x='Importance', y='Feature/Interaction', hue='Feature/Interaction', legend=False, palette='mako')\n",
    "plt.title('Top 10 Risk Drivers (Glass-Box EBM Model)', fontsize=12, fontweight='bold')\n",
    "plt.xlabel('Mean Absolute Score (Clinical Log-Odds Impact)')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
