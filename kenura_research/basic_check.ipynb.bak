   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Select terms to plot\n",
    "terms_to_plot = ['age', 'creatinine_mg_dl', 'prior_admissions_12m']\n",
    "\n",
    "fig, axes = plt.subplots(1, len(terms_to_plot), figsize=(16, 4))\n",
    "\n",
    "exp_global = ebm_global.explain_global()\n",
    "\n",
    "for idx, term in enumerate(terms_to_plot):\n",
    "    term_idx = ebm_global.term_names_.index(term)\n",
    "    data = exp_global.data(term_idx)\n",
    "    \n",
    "    # Use EBM's aligned bin coordinates and scores\n",
    "    x_vals = data['names']\n",
    "    scores = data['scores']\n",
    "    \n",
    "    # Convert to numeric if not already and drop missing-value token if present\n",
    "    x_clean = []\n",
    "    y_clean = []\n",
    "    for x, y_val in zip(x_vals, scores):\n",
    "        try:\n",
    "            x_clean.append(float(x))\n",
    "            y_clean.append(float(y_val))\n",
    "        except (ValueError, TypeError):\n",
    "            continue  # Skips string labels like 'missing'\n",
    "            \n",
    "    axes[idx].plot(x_clean, y_clean, color='darkblue', lw=2.5)\n",
    "    axes[idx].axhline(0, color='red', linestyle='--', alpha=0.6)\n",
    "    axes[idx].set_title(f'Risk Curve: f({term})', fontweight='bold', fontsize=12)\n",
    "    axes[idx].set_xlabel(term, fontsize=10)\n",
    "    axes[idx].set_ylabel('Impact on Log-Odds', fontsize=10)\n",
    "    axes[idx].grid(True, alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "83d9d3cd-584b-4766-821c-b7ab8de8ae16",
   "metadata": {},
   "source": [
    "#### Discussion\n",
    "\n",
    "- creatinine_mg_dl: Notice how it stays flat and safe below 1.5, and then spikes vertically right around 1.8–2.0 mg/dL. That matches real clinical pathophysiology for acute kidney injury / severe renal impairment.\n",
    "- age: Flips from protective to high-risk at age 58.\n",
    "- prior_admissions: Linear climb up to 3 admissions, then flattens."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 51,
   "id": "e07508ca-9a85-4cdb-b079-08fb3d3927f7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Base Intercept (beta_0): -2.1242 in logit space (Base Prob: 10.68%)\n",
      "\n",
      "Piece-wise Mathematical Equation for f(prior_admissions_12m):\n",
      "-------------------------------------------------------\n",
      " If prior_admissions_12m <= 0.5             --> contribution = +0.0000 (OR = 1.00)\n",
      " If 0.5   < prior_admissions_12m <= 1.5    --> contribution = -0.0939 (OR = 0.91)\n",
      " If 1.5   < prior_admissions_12m <= 2.5    --> contribution = +0.0327 (OR = 1.03)\n",
      " If 2.5   < prior_admissions_12m <= 3.5    --> contribution = +0.1189 (OR = 1.13)\n",
      " If 3.5   < prior_admissions_12m <= 4.5    --> contribution = +0.2540 (OR = 1.29)\n",
      " If prior_admissions_12m > 4.5              --> contribution = +0.0000 (OR = 1.00)\n",
      "-------------------------------------------------------\n"
     ]
    }
   ],
   "source": [
    "# 1. Print the Global Base Intercept (beta_0)\n",
    "beta_0 = ebm_global.intercept_[0]\n",
    "base_prob = 1 / (1 + np.exp(-beta_0))\n",
    "print(f\"Base Intercept (beta_0): {beta_0:.4f} in logit space (Base Prob: {base_prob:.2%})\")\n",
    "\n",
    "# 2. Print the exact piece-wise equation table for a clinical feature\n",
    "def print_ebm_equation(term_name):\n",
    "    term_idx = ebm_global.term_names_.index(term_name)\n",
    "    bins = ebm_global.bins_[term_idx][0]\n",
    "    scores = ebm_global.term_scores_[term_idx]\n",
    "    \n",
    "    print(f\"\\nPiece-wise Mathematical Equation for f({term_name}):\")\n",
    "    print(\"-\" * 55)\n",
    "    print(f\" If {term_name} <= {bins[0]:<6.1f}          --> contribution = {scores[0]:+.4f} (OR = {np.exp(scores[0]):.2f})\")\n",
    "    \n",
    "    for i in range(len(bins) - 1):\n",
    "        print(f\" If {bins[i]:<5.1f} < {term_name} <= {bins[i+1]:<6.1f} --> contribution = {scores[i+1]:+.4f} (OR = {np.exp(scores[i+1]):.2f})\")\n",
    "        \n",
    "    print(f\" If {term_name} > {bins[-1]:<6.1f}           --> contribution = {scores[-1]:+.4f} (OR = {np.exp(scores[-1]):.2f})\")\n",
    "    print(\"-\" * 55)\n",
    "\n",
    "# Example: Print exact formula for prior admissions\n",
    "print_ebm_equation('prior_admissions_12m')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b07e7eb1-f306-4b52-9f62-adface846c0d",
   "metadata": {},
   "source": [
    "### 5-Fold Tabular Neural Network (MLP)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "cb51f4ad-a4cc-431a-bb68-3497647901f1",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--> Training 5-Fold Tabular Neural Network (MLP)...\n",
      "\n",
      "=============================================\n",
      "MLP (Neural Net) OOF Log Loss: 0.36054\n",
      "MLP (Neural Net) ROC-AUC:      0.66723\n",
      "=============================================\n"
     ]
    }
   ],
   "source": [
    "from sklearn.neural_network import MLPClassifier\n",
    "from sklearn.preprocessing import StandardScaler, OneHotEncoder\n",
    "from sklearn.compose import ColumnTransformer\n",
    "from sklearn.pipeline import Pipeline\n",
    "\n",
    "print(\"--> Training 5-Fold Tabular Neural Network (MLP)...\")\n",
    "\n",
    "oof_mlp = np.zeros(len(train_fe))\n",
    "test_preds_mlp = np.zeros(len(test_fe))\n",
    "\n",
    "# Identify column types for the neural pipeline\n",
    "nn_num_cols = X.select_dtypes(include=[np.number]).columns.tolist()\n",
    "nn_cat_cols = X.select_dtypes(include=['category', 'object', 'string', 'str']).columns.tolist()\n",
    "\n",
    "# Preprocessing: Neural nets require scaled continuous features & one-hot encoded categories\n",
    "preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        ('num', StandardScaler(), nn_num_cols),\n",
    "        ('cat', OneHotEncoder(handle_unknown='ignore', sparse_output=False), nn_cat_cols)\n",
    "    ]\n",
    ")\n",
    "\n",
    "for fold, (trn_idx, val_idx) in enumerate(skf.split(X, y), 1):\n",
    "    X_tr_raw, y_tr = X.iloc[trn_idx], y[trn_idx]\n",
    "    X_va_raw, y_va = X.iloc[val_idx], y[val_idx]\n",
    "    \n",
    "    # Fit scaler & encoder on train only (avoids data leakage)\n",
    "    X_tr_proc = preprocessor.fit_transform(X_tr_raw)\n",
    "    X_va_proc = preprocessor.transform(X_va_raw)\n",
    "    X_te_proc = preprocessor.transform(X_test)\n",
    "    \n",
    "    # Regularized 2-layer Neural Net with early stopping\n",
    "    mlp = MLPClassifier(\n",
    "        hidden_layer_sizes=(64, 32),\n",
    "        activation='relu',\n",
    "        alpha=0.05,               # L2 Weight Decay to prevent overconfidence\n",
    "        batch_size=64,\n",
    "        learning_rate_init=0.003,\n",
    "        max_iter=200,\n",
    "        early_stopping=True,\n",
    "        n_iter_no_change=15,\n",
    "        random_state=42 + fold\n",
    "    )\n",
    "    \n",
    "    mlp.fit(X_tr_proc, y_tr)\n",
    "    \n",
    "    oof_mlp[val_idx] = mlp.predict_proba(X_va_proc)[:, 1]\n",
    "    test_preds_mlp += mlp.predict_proba(X_te_proc)[:, 1] / 5\n",
    "\n",
    "oof_mlp = np.clip(oof_mlp, 0.005, 0.995)\n",
    "test_preds_mlp = np.clip(test_preds_mlp, 0.005, 0.995)\n",
    "\n",
    "mlp_loss = log_loss(y, oof_mlp)\n",
    "mlp_auc = roc_auc_score(y, oof_mlp)\n",
    "\n",
    "print(\"\\n\" + \"=\"*45)\n",
    "print(f\"MLP (Neural Net) OOF Log Loss: {mlp_loss:.5f}\")\n",
    "print(f\"MLP (Neural Net) ROC-AUC:      {mlp_auc:.5f}\")\n",
    "print(\"=\"*45)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7d822297-ea35-41c8-963d-b941e7c25799",
   "metadata": {},
   "source": [
    "### 5-Fold Spline GAM"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 55,
   "id": "1502ef96-03ac-49c4-b89f-4d886d3ebec0",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--> Training 5-Fold Spline GAM (Natural B-Splines + Logistic Regression)...\n",
      "\n",
      "=============================================\n",
      "Spline GAM OOF Log Loss:  0.35039  (Linear Logistic: 0.35261)\n",
      "Spline GAM ROC-AUC:       0.68863  (Linear Logistic: 0.68529)\n",
      "=============================================\n"
     ]
    }
   ],
   "source": [
    "from sklearn.preprocessing import SplineTransformer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.pipeline import make_pipeline\n",
    "\n",
    "print(\"--> Training 5-Fold Spline GAM (Natural B-Splines + Logistic Regression)...\")\n",
    "\n",
    "oof_spline = np.zeros(len(train_fe))\n",
    "test_preds_spline = np.zeros(len(test_fe))\n",
    "\n",
    "# Select continuous clinical features where smooth non-linear curves matter\n",
    "spline_cols = [\n",
    "    'age', 'creatinine_mg_dl', 'hemoglobin_g_dl', 'sodium_mmol_l',\n",
    "    'heart_rate_bpm', 'systolic_bp_mmhg', 'prior_admissions_12m', 'length_of_stay_days'\n",
    "]\n",
    "other_cols = [c for c in X.columns if c not in spline_cols and not c.endswith('_isna')]\n",
    "\n",
    "# Spline preprocessor: 5 knots, cubic degree (smooth 3rd-order polynomials)\n",
    "spline_preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        ('spline', make_pipeline(StandardScaler(), SplineTransformer(n_knots=5, degree=3)), spline_cols),\n",
    "        ('other_num', StandardScaler(), [c for c in other_cols if c in nn_num_cols]),\n",
    "        ('cat', OneHotEncoder(handle_unknown='ignore', sparse_output=False), [c for c in other_cols if c in nn_cat_cols])\n",
    "    ]\n",
    ")\n",
    "\n",
    "for fold, (trn_idx, val_idx) in enumerate(skf.split(X, y), 1):\n",
    "    X_tr_raw, y_tr = X.iloc[trn_idx], y[trn_idx]\n",
    "    X_va_raw, y_va = X.iloc[val_idx], y[val_idx]\n",
    "    \n",
    "    X_tr_sp = spline_preprocessor.fit_transform(X_tr_raw)\n",
    "    X_va_sp = spline_preprocessor.transform(X_va_raw)\n",
    "    X_te_sp = spline_preprocessor.transform(X_test)\n",
    "    \n",
    "    # L2-penalized logistic regression fitted over the spline basis\n",
    "    spline_model = LogisticRegression(C=0.1, max_iter=1000, random_state=42)\n",
    "    spline_model.fit(X_tr_sp, y_tr)\n",
    "    \n",
    "    oof_spline[val_idx] = spline_model.predict_proba(X_va_sp)[:, 1]\n",
    "    test_preds_spline += spline_model.predict_proba(X_te_sp)[:, 1] / 5\n",
    "\n",
    "oof_spline = np.clip(oof_spline, 0.005, 0.995)\n",
    "test_preds_spline = np.clip(test_preds_spline, 0.005, 0.995)\n",
    "\n",
    "spline_loss = log_loss(y, oof_spline)\n",
    "spline_auc = roc_auc_score(y, oof_spline)\n",
    "\n",
    "print(\"\\n\" + \"=\"*45)\n",
    "print(f\"Spline GAM OOF Log Loss:  {spline_loss:.5f}  (Linear Logistic: 0.35261)\")\n",
    "print(f\"Spline GAM ROC-AUC:       {spline_auc:.5f}  (Linear Logistic: 0.68529)\")\n",
    "print(\"=\"*45)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1593d087-6b70-496e-bb5a-b37160fbcbe4",
   "metadata": {},
   "source": [
    "### Stacking Meta-Learner"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 60,
   "id": "4d5321bf-1b5f-4947-be98-5f5a7e28f50d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "--> Optimizing Level-2 Stacking Super-Learner across 4 Model Families...\n",
      "\n",
      "==================================================\n",
      "          SUPER-LEARNER META-WEIGHTS               \n",
      "==================================================\n",
      "  1. Spline GAM (Parametric):        0.403\n",
      "  2. EBM (Glass-Box GAM²):           0.302\n",
      "  3. CatBoost (Symmetric Trees):     0.242\n",
      "  4. LightGBM (Leaf-wise GBDT):      0.052\n",
      "==================================================\n",
      "--> Stacking Super-Learner OOF Log Loss: 0.34913\n",
      "--> Stacking Super-Learner ROC-AUC:      0.69252\n",
      "--> Stacking Super-Learner Brier Score:  0.10227\n",
      "==================================================\n",
      "Saved to ../outputs/submission_06_super_learner.csv\n"
     ]
    }
   ],
   "source": [
    "from scipy.optimize import minimize\n",
    "\n",
    "print(\"--> Optimizing Level-2 Stacking Super-Learner across 4 Model Families...\")\n",
    "\n",
    "# Level-1 Out-of-Fold Matrix (7000 rows x 4 models)\n",
    "S_train = np.column_stack([oof_spline, oof_ebm, oof_cb, oof_lgb])\n",
    "S_test = np.column_stack([test_preds_spline, test_preds_ebm, test_preds_cb, test_preds_lgb])\n",
    "\n",
    "# Convert probabilities to log-odds (logits) for stable linear meta-modeling\n",
    "eps = 1e-6\n",
    "S_train_clipped = np.clip(S_train, eps, 1 - eps)\n",
    "S_test_clipped = np.clip(S_test, eps, 1 - eps)\n",
    "\n",
    "# Constrained SLSQP optimizer: weights >= 0, sum(weights) == 1\n",
    "def meta_loss(w):\n",
    "    pred = np.dot(S_train, w)\n",
    "    return log_loss(y, np.clip(pred, 0.005, 0.995))\n",
    "\n",
    "init_weights = [0.25, 0.25, 0.25, 0.25]\n",
    "bounds = [(0, 1)] * 4\n",
    "constraints = {'type': 'eq', 'fun': lambda w: np.sum(w) - 1.0}\n",
    "\n",
    "opt_res = minimize(meta_loss, init_weights, method='SLSQP', bounds=bounds, constraints=constraints)\n",
    "w_spline, w_ebm, w_cb, w_lgb = opt_res.x\n",
    "\n",
    "print(\"\\n\" + \"=\"*50)\n",
    "print(\"          SUPER-LEARNER META-WEIGHTS               \")\n",
    "print(\"=\"*50)\n",
    "print(f\"  1. Spline GAM (Parametric):        {w_spline:.3f}\")\n",
    "print(f\"  2. EBM (Glass-Box GAM²):           {w_ebm:.3f}\")\n",
    "print(f\"  3. CatBoost (Symmetric Trees):     {w_cb:.3f}\")\n",
    "print(f\"  4. LightGBM (Leaf-wise GBDT):      {w_lgb:.3f}\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "# Final Stacking Out-of-Fold and Test Predictions\n",
    "oof_super = np.dot(S_train, opt_res.x)\n",
    "test_super = np.dot(S_test, opt_res.x)\n",
    "\n",
    "oof_super = np.clip(oof_super, 0.005, 0.995)\n",
    "test_super = np.clip(test_super, 0.005, 0.995)\n",
    "\n",
    "super_loss = log_loss(y, oof_super)\n",
    "super_auc = roc_auc_score(y, oof_super)\n",
    "super_brier = brier_score_loss(y, oof_super)\n",
    "\n",
    "print(f\"--> Stacking Super-Learner OOF Log Loss: {super_loss:.5f}\")\n",
    "print(f\"--> Stacking Super-Learner ROC-AUC:      {super_auc:.5f}\")\n",
    "print(f\"--> Stacking Super-Learner Brier Score:  {super_brier:.5f}\")\n",
    "print(\"=\"*50)\n",
    "\n",
    "# Save the Ultimate Grand Master Submission\n",
    "sub_super = pd.DataFrame({\n",
    "    'patient_id': test_fe['patient_id'],\n",
    "    'readmitted_30d': test_super\n",
    "})\n",
    "sub_super.to_csv('../outputs/submission_06_super_learner.csv', index=False)\n",
    "print(\"Saved to ../outputs/submission_06_super_learner.csv\")"
   ]
  },
