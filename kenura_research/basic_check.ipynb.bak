   "source": [
    "records = []\n",
    "\n",
    "for col in train.columns:\n",
    "    if col == 'patient_id':\n",
    "        continue\n",
    "        \n",
    "    dtype = str(train[col].dtype)\n",
    "    n_missing = train[col].isna().sum()\n",
    "    pct_missing = (n_missing / len(train)) * 100\n",
    "    test_missing = (test[col].isna().sum() / len(test)) * 100 if col in test.columns else np.nan\n",
    "    n_unique = train[col].nunique()\n",
    "    \n",
    "    # Numeric variables\n",
    "    if pd.api.types.is_numeric_dtype(train[col]) and n_unique > 2:\n",
    "        val_min = train[col].min()\n",
    "        val_median = train[col].median()\n",
    "        val_max = train[col].max()\n",
    "        val_mean = train[col].mean()\n",
    "        val_std = train[col].std()\n",
    "        corr = train[col].corr(train['readmitted_30d'])\n",
    "        \n",
    "        stat_summary = f\"mean={val_mean:.1f}±{val_std:.1f} | min={val_min:.1f} med={val_median:.1f} max={val_max:.1f}\"\n",
    "        signal = f\"corr={corr:+.3f}\"\n",
    "        \n",
    "    # Categorical or Binary variables\n",
    "    else:\n",
    "        top_val = train[col].mode()[0]\n",
    "        top_pct = (train[col] == top_val).mean() * 100\n",
    "        stat_summary = f\"mode='{top_val}' ({top_pct:.1f}%)\"\n",
    "        \n",
    "        # Calculate max spread in readmission rate across categories\n",
    "        if col != 'readmitted_30d':\n",
    "            rate_by_cat = train.groupby(col)['readmitted_30d'].mean()\n",
    "            spread = rate_by_cat.max() - rate_by_cat.min()\n",
    "            signal = f\"rate spread: {rate_by_cat.min():.1%} → {rate_by_cat.max():.1%} (Δ={spread:.1%})\"\n",
    "        else:\n",
    "            signal = f\"prevalence = {train[col].mean():.1%}\"\n",
    "\n",
    "    records.append({\n",
    "        'Feature': col,\n",
    "        'Type': dtype,\n",
    "        'Train Miss%': f\"{pct_missing:.1f}%\",\n",
    "        'Test Miss%': f\"{test_missing:.1f}%\" if not np.isnan(test_missing) else \"-\",\n",
    "        'Unique': n_unique,\n",
    "        'Distribution Summary': stat_summary,\n",
    "        'Readmission Signal': signal\n",
    "    })\n",
    "\n",
    "stats_df = pd.DataFrame(records)\n",
    "\n",
    "# Print as a clean, readable text table\n",
    "print(\"=\" * 120)\n",
    "print(f\"VARIABLE AUDIT TABLE ({len(stats_df)} Features)\")\n",
    "print(\"=\" * 120)\n",
    "stats_df"
   ]
  },
