   "source": [
    "# =============================================================\n",
    "# OUT-OF-THE-BOX STATISTICAL MODELS: CLOGLOG GLM & SHRINKAGE LDA\n",
    "# =============================================================\n",
    "from sklearn.discriminant_analysis import LinearDiscriminantAnalysis\n",
    "import statsmodels.api as sm\n",
    "\n",
    "print(\"--> Reverting to clean 41-feature space & training Pure Statistical Models...\")\n",
    "\n",
    "# 1. Clean drop of the 7 collinear compound features\n",
    "cols_to_remove = [\n",
    "    'unsupported_frail_home', 'hyponatremic_hf', 'delayed_high_risk_followup',\n",
    "    'meds_per_comorbidity', 'severe_polypharmacy', 'access_barrier_score', 'facility_pathway'\n",
    "]\n",
    "for col in cols_to_remove:\n",
    "    if col in train_fe.columns:\n",
    "        train_fe.drop(columns=[col], inplace=True)\n",
    "        test_fe.drop(columns=[col], inplace=True)\n",
    "\n",
    "X = train_fe.drop(columns=drop_cols)\n",
    "X_test = test_fe.drop(columns=['patient_id'])\n",
    "\n",
    "# Refresh categories\n",
    "cat_features_clean = X.select_dtypes(include=['object', 'category', 'string', 'str']).columns.tolist()\n",
    "for c in cat_features_clean:\n",
    "    X[c] = X[c].astype('category')\n",
    "    X_test[c] = X_test[c].astype('category')\n",
    "\n",
    "print(f\"Clean feature count restored to: {X.shape[1]}\")\n",
    "\n",
    "oof_lda = np.zeros(len(train_fe))\n",
    "test_lda = np.zeros(len(test_fe))\n",
    "oof_cloglog = np.zeros(len(train_fe))\n",
    "test_cloglog = np.zeros(len(test_fe))\n",
    "\n",
    "# Preprocessor for parametric statistical models (Scale + One-Hot)\n",
    "stat_num_cols = X.select_dtypes(include=[np.number]).columns.tolist()\n",
    "stat_cat_cols = [c for c in X.columns if c not in stat_num_cols]\n",
    "\n",
    "stat_preprocessor = ColumnTransformer(\n",
    "    transformers=[\n",
    "        ('num', StandardScaler(), stat_num_cols),\n",
    "        ('cat', OneHotEncoder(handle_unknown='ignore', sparse_output=False, drop='first'), stat_cat_cols)\n",
    "    ]\n",
    ")\n",
    "\n",
    "for fold, (trn_idx, val_idx) in enumerate(skf.split(X, y), 1):\n",
    "    X_tr_raw, y_tr = X.iloc[trn_idx], y[trn_idx]\n",
    "    X_va_raw, y_va = X.iloc[val_idx], y[val_idx]\n",
    "    \n",
    "    X_tr_p = stat_preprocessor.fit_transform(X_tr_raw)\n",
    "    X_va_p = stat_preprocessor.transform(X_va_raw)\n",
    "    X_te_p = stat_preprocessor.transform(X_test)\n",
    "    \n",
    "    # Model 1: Linear Discriminant Analysis with Ledoit-Wolf Covariance Shrinkage\n",
    "    # Shrinkage pulls the empirical covariance matrix toward identity to prevent ill-conditioning\n",
    "    lda = LinearDiscriminantAnalysis(solver='lsqr', shrinkage='auto')\n",
    "    lda.fit(X_tr_p, y_tr)\n",
    "    oof_lda[val_idx] = lda.predict_proba(X_va_p)[:, 1]\n",
    "    test_lda += lda.predict_proba(X_te_p)[:, 1] / 5\n",
    "    \n",
    "    # Model 2: Statsmodels GLM with Complementary Log-Log Link (Survival Hazard Link)\n",
    "    # Add constant for intercept\n",
    "    X_tr_const = sm.add_constant(X_tr_p, has_constant='add')\n",
    "    X_va_const = sm.add_constant(X_va_p, has_constant='add')\n",
    "    X_te_const = sm.add_constant(X_te_p, has_constant='add')\n",
    "    \n",
    "    # Fit regularized Cloglog GLM\n",
    "    try:\n",
    "        glm_cloglog = sm.GLM(\n",
    "            y_tr, X_tr_const, \n",
    "            family=sm.families.Binomial(link=sm.families.links.CLogLog())\n",
    "        )\n",
    "        # Elastic-net penalized fit to handle multicollinearity\n",
    "        glm_res = glm_cloglog.fit_regularized(alpha=0.01, L1_wt=0.1, maxiter=200)\n",
    "        \n",
    "        oof_cloglog[val_idx] = glm_res.predict(X_va_const)\n",
    "        test_cloglog += glm_res.predict(X_te_const) / 5\n",
    "    except Exception:\n",
    "        # Fallback to standard GLM if convergence encounters singular matrix\n",
    "        glm_res = glm_cloglog.fit()\n",
    "        oof_cloglog[val_idx] = glm_res.predict(X_va_const)\n",
    "        test_cloglog += glm_res.predict(X_te_const) / 5\n",
    "\n",
    "oof_lda = np.clip(oof_lda, 0.005, 0.995)\n",
    "oof_cloglog = np.clip(oof_cloglog, 0.005, 0.995)\n",
    "\n",
    "print(\"\\n\" + \"=\"*50)\n",
    "print(\"       OUT-OF-THE-BOX STATISTICAL RESULTS          \")\n",
    "print(\"=\"*50)\n",
    "print(f\"1. Shrinkage LDA OOF Log Loss:   {log_loss(y, oof_lda):.5f} | AUC: {roc_auc_score(y, oof_lda):.5f}\")\n",
    "print(f\"2. Cloglog GLM (Hazard Link):   {log_loss(y, oof_cloglog):.5f} | AUC: {roc_auc_score(y, oof_cloglog):.5f}\")\n",
    "print(\"=\"*50)"
   ]
  }
