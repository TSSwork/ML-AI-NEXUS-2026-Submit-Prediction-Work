   "source": [
    "fig, ax = plt.subplots(1, 2, figsize=(14, 5))\n",
    "(train.isnull().mean() * 100).plot(kind='barh', ax=ax[0], color='skyblue', title='Train % Missing')\n",
    "(test.isnull().mean() * 100).plot(kind='barh', ax=ax[1], color='coral', title='Test % Missing')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
