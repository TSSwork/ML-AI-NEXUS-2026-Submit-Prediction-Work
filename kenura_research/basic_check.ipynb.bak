   ],
   "source": [
    "# -------------------------------------------------------------------\n",
    "# Form-Style Validation & Biological Range Schema\n",
    "# -------------------------------------------------------------------\n",
    "VALIDATION_RULES = {\n",
    "    # Identifier\n",
    "    'patient_id': {'type': 'str', 'regex': r'^(TR|TE)\\d{5}$', 'nullable': False},\n",
    "    \n",
    "    # Demographics & Context\n",
    "    'age': {'type': 'float', 'min': 18.0, 'max': 110.0, 'nullable': False},\n",
    "    'sex': {'type': 'str', 'allowed': {'Male', 'Female'}, 'nullable': False},\n",
    "    'rurality': {'type': 'str', 'allowed': {'Urban', 'Semi-urban', 'Rural'}, 'nullable': False},\n",
    "    'socioeconomic_index': {'type': 'float', 'min': -5.0, 'max': 5.0, 'nullable': False},\n",
    "    'hospital_type': {'type': 'str', 'allowed': {'Teaching', 'General', 'District'}, 'nullable': False},\n",
    "    'region': {'type': 'str', 'allowed': {'West', 'North-East', 'Central', 'South'}, 'nullable': False},\n",
    "    \n",
    "    # Counts & History\n",
    "    'prior_admissions_12m': {'type': 'int', 'min': 0, 'max': 50, 'nullable': False},\n",
    "    'comorbidity_count': {'type': 'int', 'min': 0, 'max': 20, 'nullable': False},\n",
    "    'medication_count': {'type': 'int', 'min': 0, 'max': 50, 'nullable': False},\n",
    "    'missed_appointments_12m': {'type': 'int', 'min': 0, 'max': 50, 'nullable': False},\n",
    "    'length_of_stay_days': {'type': 'float', 'min': 0.1, 'max': 180.0, 'nullable': False},\n",
    "    'followup_days': {'type': 'float', 'min': 0.0, 'max': 90.0, 'nullable': True},  # Missing allowed\n",
    "    \n",
    "    # Binary Flags\n",
    "    'diabetes': {'type': 'binary', 'allowed': {0, 1}, 'nullable': False},\n",
    "    'hypertension': {'type': 'binary', 'allowed': {0, 1}, 'nullable': False},\n",
    "    'chronic_kidney_disease': {'type': 'binary', 'allowed': {0, 1}, 'nullable': False},\n",
    "    'heart_failure': {'type': 'binary', 'allowed': {0, 1}, 'nullable': False},\n",
    "    \n",
    "    # Physiological Vitals & Labs (Standard Clinical Plausibility Ranges)\n",
    "    'hemoglobin_g_dl': {'type': 'float', 'min': 4.0, 'max': 22.0, 'nullable': True},\n",
    "    'creatinine_mg_dl': {'type': 'float', 'min': 0.2, 'max': 15.0, 'nullable': True},\n",
    "    'sodium_mmol_l': {'type': 'float', 'min': 110.0, 'max': 170.0, 'nullable': True},\n",
    "    'heart_rate_bpm': {'type': 'float', 'min': 30.0, 'max': 220.0, 'nullable': True},\n",
    "    'systolic_bp_mmhg': {'type': 'float', 'min': 50.0, 'max': 260.0, 'nullable': True},\n",
    "    \n",
    "    # Discharges & Workflow\n",
    "    'discharge_disposition': {'type': 'str', 'allowed': {'Home', 'Rehab', 'Home_with_support', 'Other'}, 'nullable': False},\n",
    "    'care_pathway': {'type': 'str', 'allowed': {'P1', 'P2', 'P3', 'P4'}, 'nullable': False},\n",
    "    'readmitted_30d': {'type': 'binary', 'allowed': {0, 1}, 'nullable': False}\n",
    "}\n",
    "\n",
    "def validate_dataset(df, name=\"Dataset\"):\n",
    "    violations = []\n",
    "    \n",
    "    for col, rule in VALIDATION_RULES.items():\n",
    "        if col not in df.columns:\n",
    "            if col == 'readmitted_30d' and name == \"Test\":\n",
    "                continue  # Expected in test set\n",
    "            violations.append((col, \"Missing Column\", f\"Column missing from {name}\"))\n",
    "            continue\n",
    "            \n",
    "        series = df[col]\n",
    "        \n",
    "        # 1. Null / Empty Check\n",
    "        null_count = series.isna().sum()\n",
    "        if null_count > 0:\n",
    "            if not rule['nullable']:\n",
    "                violations.append((col, \"FATAL: Unexpected Nulls\", f\"{null_count} nulls (nullable=False)\"))\n",
    "            else:\n",
    "                pct = (null_count / len(series)) * 100\n",
    "                violations.append((col, \"INFO: Permitted Missing\", f\"{null_count} nulls ({pct:.2f}%)\"))\n",
    "                \n",
    "        valid_vals = series.dropna()\n",
    "        \n",
    "        # 2. Categorical Set Check\n",
    "        if 'allowed' in rule:\n",
    "            unrecognized = set(valid_vals.unique()) - rule['allowed']\n",
    "            if unrecognized:\n",
    "                violations.append((col, \"Invalid Categorical Value\", f\"Unrecognized: {unrecognized}\"))\n",
    "                \n",
    "        # 3. Numeric Range Check (Min / Max)\n",
    "        if 'min' in rule and len(valid_vals) > 0:\n",
    "            below_min = (valid_vals < rule['min']).sum()\n",
    "            above_max = (valid_vals > rule['max']).sum()\n",
    "            if below_min > 0 or above_max > 0:\n",
    "                violations.append((col, \"Out of Range\", f\"{below_min} below {rule['min']}, {above_max} above {rule['max']}\"))\n",
    "                \n",
    "        # 4. Regex Check (e.g., patient_id prefix)\n",
    "        if 'regex' in rule:\n",
    "            non_matching = (~valid_vals.astype(str).str.match(rule['regex'])).sum()\n",
    "            if non_matching > 0:\n",
    "                violations.append((col, \"Pattern Mismatch\", f\"{non_matching} IDs do not match {rule['regex']}\"))\n",
    "\n",
    "    # Print Summary Report\n",
    "    print(f\"\\n{'='*30} {name.upper()} VALIDATION REPORT {'='*30}\")\n",
    "    if not violations:\n",
    "        print(\" [PASS] 0 violations found. All types, categories, and ranges are valid.\")\n",
    "    else:\n",
    "        report_df = pd.DataFrame(violations, columns=['Column', 'Check Failed', 'Details'])\n",
    "        print(report_df.to_string(index=False))\n",
    "\n",
    "# Run checks\n",
    "validate_dataset(train, name=\"Train\")\n",
    "validate_dataset(test, name=\"Test\")"
   ]
  },
